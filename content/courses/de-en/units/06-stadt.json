          "pairs": [
            { "target": "weit", "base": "far" },
            { "target": "nah", "base": "near" },
            { "target": "nicht", "base": "not" },
            { "target": "kein Hotel", "base": "no hotel" },
            { "target": "keine Kinos", "base": "no cinemas" }
          ]
        },
