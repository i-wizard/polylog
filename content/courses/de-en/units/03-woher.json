    {
      "id": "w3-present-tense",
      "title": "Regular verbs",
      "kind": "LEARN",
      "introduces": ["wir", "ihr", "sie-they", "lernen", "machen", "was"],
      "exercises": [
        {
          "id": "w3-e1",
          "type": "TEACH",
          "title": "The present tense",
          "body": "Every regular verb follows this pattern. Take the stem (**lern-**) and add:\n\n- ich lern**e**\n- du lern**st**\n- er / sie lern**t**\n- wir lern**en**: we\n- ihr lern**t**: you, talking to several friends\n- sie / Sie lern**en**: they / you (formal)\n\n*wir*, *sie* and *Sie* always look just like the infinitive.",
          "examples": [
            { "text": "ich lerne", "translation": "I learn / I'm learning" },
            { "text": "du lernst", "translation": "you learn" },
            { "text": "er lernt", "translation": "he learns" },
            { "text": "wir lernen", "translation": "we learn" },
            { "text": "ihr lernt", "translation": "you (all) learn" },
            { "text": "sie lernen", "translation": "they learn" }
          ]
        },
        {
          "id": "w3-e2",
          "type": "MATCH_PAIRS",
          "pairs": [
            { "target": "ich lerne", "base": "I learn" },
            { "target": "du lernst", "base": "you learn" },
            { "target": "wir lernen", "base": "we learn" },
            { "target": "ihr lernt", "base": "you all learn" },
            { "target": "sie lernen", "base": "they learn" }
          ]
        },
