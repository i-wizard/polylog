    { "id": "freundin", "text": "Freundin", "translations": ["friend (female)", "girlfriend"], "partOfSpeech": "NOUN", "gender": "f", "plural": "Freundinnen", "pronunciation": "FROYN-din", "example": { "text": "Das ist meine Freundin Lisa.", "translation": "This is my friend Lisa." } },
