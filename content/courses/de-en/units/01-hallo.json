    {
      "id": "h4-formal",
      "title": "Formal you: Sie",
      "kind": "LEARN",
      "introduces": ["sie-formal", "sein", "herr", "frau", "freut-mich"],
      "exercises": [
        {
          "id": "h4-e1",
          "type": "TEACH",
          "title": "du or Sie?",
          "body": "German has two words for *you*:\n\n- **du**: friends, family, children, and people your age in casual settings\n- **Sie**: strangers, shop staff, colleagues you don't know well, older people. Always written with a capital S.\n\nWith **Sie**, use the surname: **Herr Weber** (Mr Weber), **Frau Schmidt** (Mrs/Ms Schmidt). *Frau* is used for all adult women, married or not.",
          "examples": [
            { "text": "Wie heißen Sie?", "translation": "What's your name? (formal)" },
            { "text": "Guten Tag, Herr Weber!", "translation": "Hello, Mr Weber!" },
            { "text": "Guten Abend, Frau Schmidt!", "translation": "Good evening, Ms Schmidt!" }
          ]
        },
        {
          "id": "h4-e2",
          "type": "MULTIPLE_CHOICE",
          "instruction": "You meet your new manager, Mr Fischer. Which greeting fits?",
          "prompt": "Meeting Mr Fischer",
          "promptLanguage": "BASE",
          "options": ["Guten Tag, Herr Fischer!", "Hallo, du!", "Tschüss, Herr Fischer!"],
          "optionsLanguage": "TARGET",
          "answerIndex": 0
        },
        {
          "id": "h4-e3",
          "type": "TEACH",
          "title": "The verb sein (to be)",
          "body": "**sein** is irregular, so learn its forms by heart:\n\n- **ich bin**: I am\n- **du bist**: you are (informal)\n- **Sie sind**: you are (formal)\n\nThe full table is in this unit's notes.",
          "examples": [
            { "text": "Ich bin Anna.", "translation": "I am Anna." },
            { "text": "Du bist Tom.", "translation": "You are Tom." },
            { "text": "Sind Sie Frau Schmidt?", "translation": "Are you Ms Schmidt?" }
          ]
        },
