    {
      "id": "h3-how-are-you",
      "title": "How are you?",
      "kind": "LEARN",
      "introduces": ["wie-geht-es-dir", "und-dir", "gut", "sehr", "danke", "bitte", "auch"],
      "exercises": [
        {
          "id": "h3-e1",
          "type": "TEACH",
          "title": "Wie geht es dir?",
          "body": "To ask a friend how they are:\n\n- **Wie geht es dir?** How are you? (literally *How goes it for you?*)\n- Short and casual: **Wie geht's?**\n\nTypical answers:\n\n- **Gut, danke!** Good, thanks!\n- **Sehr gut!** Very good!\n- **Es geht.** So-so.\n\nThen return the question: **Und dir?** And you?",
          "examples": [
            { "text": "Wie geht es dir?", "translation": "How are you?" },
            { "text": "Gut, danke!", "translation": "Good, thanks!" },
            { "text": "Sehr gut!", "translation": "Very good!" },
            { "text": "Es geht.", "translation": "So-so." },
            { "text": "Und dir?", "translation": "And you?" }
          ]
        },
        {
          "id": "h3-e2",
          "type": "MULTIPLE_CHOICE",
          "prompt": "Gut, danke!",
          "promptLanguage": "TARGET",
          "options": ["Good, thanks!", "Very good!", "And you?"],
          "optionsLanguage": "BASE",
          "answerIndex": 0
        },
        {
          "id": "h3-e3",
          "type": "WORD_ORDER",
          "translation": "How are you?",
          "answer": "Wie geht es dir?",
          "distractors": ["du", "Sie"]
        },
        {
          "id": "h3-e4",
          "type": "LISTEN_CHOOSE",
          "options": ["Sehr gut!", "Gut, danke!", "Und dir?"],
          "answerIndex": 0
        },
        {
          "id": "h3-e5",
          "type": "TEACH",
          "title": "danke and bitte",
          "body": "- **danke** = thank you, thanks. **Danke schön** = thank you very much\n- **bitte** = please, *and* the reply to *danke*: you're welcome\n\n*Danke! — Bitte!* is one of the most common exchanges in German.",
          "examples": [
            { "text": "Danke schön!", "translation": "Thank you very much!" },
            { "text": "Bitte!", "translation": "You're welcome! / Please!" }
          ]
        },
