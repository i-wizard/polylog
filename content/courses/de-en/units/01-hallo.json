  "grammarNotes": [
    {
      "id": "hallo-sein",
      "title": "sein — to be",
      "body": "The most important verb in German, and it's irregular. You've practised **ich bin**, **du bist** and **Sie sind**; the other forms come in later units.",
      "table": [
        ["Person", "sein", "English"],
        ["ich", "bin", "I am"],
        ["du", "bist", "you are (informal)"],
        ["er / sie / es", "ist", "he / she / it is"],
        ["wir", "sind", "we are"],
        ["ihr", "seid", "you are (informal, plural)"],
        ["sie / Sie", "sind", "they are / you are (formal)"]
      ]
    },
    {
      "id": "hallo-heissen",
      "title": "heißen — to be called",
      "body": "A regular verb: take the stem **heiß-** and add the ending. Because the stem already ends in *ß*, the *du* form is **heißt** rather than *heißst*.",
      "table": [
        ["Person", "heißen"],
        ["ich", "heiße"],
        ["du", "heißt"],
        ["er / sie / es", "heißt"],
        ["wir", "heißen"],
        ["ihr", "heißt"],
        ["sie / Sie", "heißen"]
      ]
    },
    {
      "id": "hallo-du-sie",
      "title": "du or Sie?",
      "body": "- **du**: friends, family, children, and people your age in casual settings\n- **Sie**: strangers, shop staff, colleagues you don't know well, older people\n\nWith **Sie**, use the surname: *Herr Weber, Frau Schmidt*. **Frau** is used for all adult women, married or not. When unsure, start with *Sie* — Germans will offer *du* if they want it."
    },
    {
      "id": "hallo-capitals",
      "title": "Capital letters",
      "body": "German capitalises **every noun**: *der Name, die Frau, der Morgen*. The formal **Sie** is always capitalised; **ich** is not, unless it starts a sentence."
    }
  ],
  "lessons": [
    {
      "id": "h1-greetings",
      "title": "Greetings",
      "kind": "LEARN",
      "introduces": ["hallo", "guten-morgen", "guten-tag", "guten-abend", "gute-nacht", "tschuess", "auf-wiedersehen"],
      "exercises": [
        {
          "id": "h1-e1",
          "type": "TEACH",
          "title": "Saying hello",
          "body": "Germans often greet according to the time of day:\n\n- **Guten Morgen** until about 11 am\n- **Guten Tag** during the day: a polite, all-purpose hello\n- **Guten Abend** from about 6 pm\n- **Gute Nacht** only when someone is going to bed\n\n**Hallo** is the everyday, informal hello and works at any time.",
          "examples": [
            { "text": "Hallo!", "translation": "Hello! / Hi!" },
            { "text": "Guten Morgen!", "translation": "Good morning!" },
            { "text": "Guten Tag!", "translation": "Hello! / Good day!" },
            { "text": "Guten Abend!", "translation": "Good evening!" },
            { "text": "Gute Nacht!", "translation": "Good night!" }
          ]
        },
        {
          "id": "h1-e2",
          "type": "MULTIPLE_CHOICE",
          "prompt": "Guten Morgen!",
          "promptLanguage": "TARGET",
          "options": ["Good morning!", "Good evening!", "Good night!"],
          "optionsLanguage": "BASE",
          "answerIndex": 0
        },
        {
          "id": "h1-e3",
          "type": "LISTEN_CHOOSE",
          "options": ["Guten Abend!", "Guten Morgen!", "Gute Nacht!"],
          "answerIndex": 0
        },
        {
          "id": "h1-e4",
          "type": "TEACH",
          "title": "Saying goodbye",
          "body": "- **Tschüss** is the friendly, informal *bye*\n- **Auf Wiedersehen** is the polite goodbye: use it in shops, at work and with people you don't know\n\n*Wiedersehen* literally means *seeing again*.",
          "examples": [
            { "text": "Tschüss!", "translation": "Bye!" },
            { "text": "Auf Wiedersehen!", "translation": "Goodbye!" }
          ]
        },
        {
          "id": "h1-e5",
          "type": "MATCH_PAIRS",
          "pairs": [
            { "target": "Hallo", "base": "Hello" },
            { "target": "Guten Abend", "base": "Good evening" },
            { "target": "Gute Nacht", "base": "Good night" },
            { "target": "Tschüss", "base": "Bye" },
            { "target": "Auf Wiedersehen", "base": "Goodbye (polite)" }
          ]
        },
        {
